@{
    ViewData["Title"] = "Contactinformatie";
}

<h2>Contactinformatie</h2>

<p>Geselecteerde datum: @ViewBag.EventDate</p>

<!-- Always show the form, even for authenticated users -->
<form asp-action="Step02" method="post">
    <!-- Hidden field to include eventDate in the form submission -->
    <input type="hidden" name="eventDate" value="@ViewBag.EventDate" />
    <input type="hidden"  name="KlantkaartId" value="@Model?.KlantkaartId" />

    <label for="Name">Naam:</label>
    <input readonly type="text" id="Name" name="Name" class="form-control" value="@Model?.Name" required />

    <label for="Email" class="mt-3">E-mailadres:</label>
    <input readonly type="email" id="Email" name="Email" class="form-control" value="@Model?.Email" required />

    <label for="Phonenumber" class="mt-3">Telefoonnummer:</label>
    <input readonly type="text" id="Phonenumber" name="Phonenumber" class="form-control" value="@Model?.PhoneNumber" />

    <label for="Adres" class="mt-3">Adres:</label>
    <input readonly type="text" id="Adres" name="Adres" class="form-control" value="@Model?.Adres" />

    <button type="submit" class="btn btn-primary mt-3">Volgende</button>
</form>

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Step 03 - Beestjes</title>
    <!-- Bootstrap 5 CDN -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
</head>
<body class="container mt-4">

    <!-- Display Klant Data at the Top -->
    <div class="card p-4 mb-4 shadow-sm">
        <h2 class="mb-3">Klant Informatie</h2>
        <p><strong>Naam:</strong> @Model.Klant.Name</p>
        <p><strong>Email:</strong> @Model.Klant.Email</p>
        <p><strong>Telefoonnummer:</strong> @Model.Klant.PhoneNumber</p>
        <p><strong>Adres:</strong> @Model.Klant.Adres</p>
        <p><strong>Geselecteerde Datum:</strong> @Model.Datum</p>
    </div>

    <hr />

    <!-- Display validation errors -->
    <div class="alert alert-danger" role="alert" style="display: @((ViewData.ModelState.IsValid) ? "none" : "block")">
        @Html.ValidationSummary(true, "", new { @class = "text-danger" })
    </div>

    <!-- Form for selecting Beestjes -->
    <form asp-action="Step03" method="post">

        <!-- Hidden Fields for Klant and Datum -->
        <input type="hidden" name="Klant.Name" value="@Model.Klant.Name" />
        <input type="hidden" name="Klant.Email" value="@Model.Klant.Email" />
        <input type="hidden" name="Klant.PhoneNumber" value="@Model.Klant.PhoneNumber" />
        <input type="hidden" name="Klant.Adres" value="@Model.Klant.Adres" />
        <input type="hidden" name="Datum" value="@Model.Datum.ToString("dd-MM-yyyy")" />

        <!-- Beestjes Selection -->
        <div class="step-content">
            <h3 class="mb-4">Kies een Beestje</h3>
            <div class="row">
                @foreach (var beestje in Model.Beestjes)
                {
                    <div class="col-md-4 col-lg-3 mb-4">
                        <div class="card h-100 shadow-sm" style="background-color: #C0C0C0;">
                            <img src="@Url.Content($"~/images/beestjes/{beestje.Picture}")"
                                 class="card-img-top"
                                 alt="@beestje.Name">
                            <div class="card-body text-center">
                                <h5 class="card-title">@beestje.Name</h5>
                                <p><strong>Prijs:</strong> €@beestje.Price</p>
                                <div class="form-check">
                                    <input class="form-check-input" type="checkbox" id="beestje_@beestje.Id" name="selectedBeestjesIds" value="@beestje.Id"
                                    @(Model.SelectedBeestjesIds != null && Model.SelectedBeestjesIds.Contains(beestje.Id) ? "checked" : "")>
                                    <label class="form-check-label" for="beestje_@beestje.Id">
                                        Selecteer
                                    </label>
                                </div>
                            </div>
                        </div>
                    </div>
                }
            </div>

            <!-- Continue Process Button -->
            <div class="text-center mt-4">
                <button type="submit" class="btn btn-success btn-lg">Ga Verder</button>
            </div>
        </div>
    </form>

    <!-- Bootstrap JS (Optional) -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>

</body>
</html>

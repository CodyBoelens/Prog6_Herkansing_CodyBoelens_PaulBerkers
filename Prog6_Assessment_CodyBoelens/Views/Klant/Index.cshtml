@using Prog6_Assessment_CodyBoelens.Views.ViewModels.KlantViewModel
@model List<KlantViewModels>

@{
    ViewData["Title"] = "Klant Details";
}

<h3>@ViewData["Title"]</h3>
<hr />

@if (TempData["errorMessage"] != null)
{
    <div class="alert alert-danger" role="alert">
        @TempData["errorMessage"]
    </div>
}

@if (TempData["successMessage"] != null)
{
    <div class="alert alert-success" role="alert">
        @TempData["successMessage"]
    </div>
}

<form>
    <button asp-action="Create" asp-controller="Klant" class="btn btn-primary mb-3">Create Klant</button>
    <table class="table table-responsive table-hover table-bordered">
        <thead>
            <tr class="table-active">
                <th>Naam</th>
                <th>Adres</th>
                <th>Rank</th>
                <th>Action</th>
            </tr>
        </thead>
        <tbody>
            @if (Model != null && Model.Any())
            {
                @foreach (var klant in Model)
                {
                    <tr>
                        <td>@klant.Name</td>
                        <td>@klant.Adres</td>
                        <td>@klant.Rank</td>
                        <td>
                            <div class="btn-group btn-group-sm">
                                <a asp-controller="Klant" asp-action="Edit" asp-route-id="@klant.Id" class="btn btn-primary">Geef andere Klantenkaart</a>
                            </div>
                        </td>
                    </tr>
                }
            }
            else
            {
                <tr>
                    <td colspan="6">
                        <div>
                            Er zijn nog geen klanten gemaakt
                        </div>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</form>
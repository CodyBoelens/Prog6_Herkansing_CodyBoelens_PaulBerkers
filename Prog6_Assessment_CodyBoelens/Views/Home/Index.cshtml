@{
    ViewData["Title"] = "Beestje Op Je Feestje";
}

<form asp-controller="Boeking" asp-action="Step01" method="post">
    <div class="text-center">
        <h1 class="display-4">Welkom bij beestje op je feestje</h1>
    </div>

    @if (TempData["EventDateErrorStep01"] != null)
    {
        <div class="alert alert-danger text-center">
            @TempData["EventDateErrorStep01"]
        </div>
    }
    @if (TempData["orderSucces"] != null)
    {
        <div class="alert alert-success text-center">
            @TempData["orderSucces"]
        </div>
    }


    @if (!User.IsInRole("Boerderij"))
    {
        <div class="text-center mt-4">
            <label for="eventDate" class="form-label">Selecteer een datum voor je feestje:</label>
            <input type="date" id="eventDate" name="eventDate" class="form-control" value="@ViewBag.EventDate" style="width: 300px; margin: 0 auto;" />
        </div>

        <div class="text-center mt-3">
            <button type="submit" class="btn btn-primary">Verzenden</button>
        </div>
    }

</form>
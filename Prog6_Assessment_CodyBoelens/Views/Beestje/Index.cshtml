@using Prog6_Assessment_CodyBoelens.Views.ViewModels.BeestjeViewModel
@model List<BeestjeViewModel>

@{
    ViewData["Title"] = "Beestje Details";
}

<h3>@ViewData["Title"]</h3>
<hr />

@if (TempData["errorMessage"] != null)
{
    <div class="alert alert-danger" role="alert">
        @TempData["errorMessage"]
    </div>
}

@if (TempData["successMessage"] != null)
{
    <div class="alert alert-success" role="alert">
        @TempData["successMessage"]
    </div>
}

<form>
    <button asp-action="Create" asp-controller="Beestje" class="btn btn-primary mb-3">Create Beestje</button>
    <table class="table table-responsive table-hover table-bordered">
        <thead>
            <tr class="table-active">
                <th>Id</th>
                <th>Naam</th>
                <th>Type</th>
                <th>Prijs</th>
                <th>Action</th>
            </tr>
        </thead>
        <tbody>
            @if (Model != null && Model.Any())
            {
                @foreach (var beestje in Model)
                {
                    <tr>
                        <td>@beestje.Id</td>
                        <td>@beestje.Name</td>
                        <td>@beestje.Type</td>
                        <td>@beestje.Price</td>
                        <td>
                            <div class="btn-group btn-group-sm">
                                <a asp-controller="Beestje" asp-action="Edit" asp-route-id="@beestje.Id" class="btn btn-primary">Edit</a>
                                <a asp-controller="Beestje" asp-action="Delete" asp-route-id="@beestje.Id" class="btn btn-danger">Delete</a>
                            </div>
                        </td>
                    </tr>
                }
            }
            else
            {
                <tr>
                    <td colspan="6">
                        <div>
                            Er zijn nog geen beestjes gemaakt
                        </div>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</form>